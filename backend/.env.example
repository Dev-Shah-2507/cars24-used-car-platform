# Copy this file to .env and adjust values. Never commit .env.
PORT=5000
# Local MongoDB (default) or paste a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/car_marketplace
# Use any long random string
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
# Frontend dev server origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
